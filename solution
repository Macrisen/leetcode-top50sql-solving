#1164. Product Price at a Given Date
# Write your MySQL query statement below
WITH temporary AS (
    SELECT product_id
    ,new_price 
    , ROW_NUMBER() OVER (PARTITION BY product_id 
    ORDER BY change_date DESC) AS rn 
    FROM Products 
    WHERE change_date <= '2019-08-16' 
)
